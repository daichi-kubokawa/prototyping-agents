# 環境変数・機密（Do NOT push to Git）
local_env.json

# .env の全バリエーション（Next.js 等の .env.local / .env.production も含む）
# ただし .env.example（ダミー値のひな形）は追跡してよい　
.env*
!.env.example

# Local development and temporary logs
*.local.md

# マシン固有の権限付与（共有する意味がない）
.claude/settings.local.json

# 生のヒアリング入力（録音の文字起こし、外部整理ツールの出力）
# 個人情報を含むため Git に載せない
inputs/

# 上書き前の自動バックアップ（公開しない）
*.bak-*

# macOS
.DS_Store

# Scratch area (device_bash では削除できないため手動で削除すること)
_to_delete/
_staging/
